{
    "name": "orma_demo",
    "version": "2.0.0",
    "description": "Orma playground backend (Fastify + biab)",
    "main": "src/server.ts",
    "scripts": {
        "dev": "tsx watch --inspect -e \"import('./src/server.ts').then((m) => m.default.main())\"",
        "start": "tsx -e \"import('./src/server.ts').then((m) => m.default.main())\"",
        "deploy": "tsx -e \"import('./src/hosting/deploy.ts').then((m) => m.default.deploy())\"",
        "deploy_init": "tsx -e \"import('./src/hosting/deploy.ts').then((m) => m.default.deploy_init())\""
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@fastify/cors": "^11.0.0",
        "biab": "^1.0.68",
        "fastify": "^5.8.5",
        "orma": "^1.0.276",
        "pg": "^8.7.3",
        "promise-mysql": "^5.2.0",
        "tsx": "^4.21.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/pg": "^8.11.0",
        "typescript": "^5.9.3"
    }
}
